{
  "name": "agentguard",
  "displayName": "AgentGuard — Real-Time Codebase Safety & AI Code Review",
  "description": "Real-time codebase safety for developers and AI coding agents. Catches breaking changes in untouched files, silent regressions, and deleted security checks as you type. 100% offline.",
  "version": "2.0.0",
  "publisher": "swe-jahid-agentguard",
  "author": "Md. Jahidul Islam",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Linters",
    "Testing",
    "Programming Languages"
  ],
  "keywords": [
    "agentguard",
    "codebase-safety",
    "ai-code-review",
    "ai-coding-agents",
    "copilot",
    "cursor",
    "claude-code",
    "breaking-changes",
    "blast-radius",
    "code-safety",
    "code-review",
    "code-quality",
    "impact-analysis",
    "dependency-tracker",
    "silent-regressions",
    "logic-risks",
    "security-guard",
    "auth-checker",
    "static-analysis",
    "offline-first",
    "error-lens",
    "developer-tools",
    "real-time",
    "refactoring",
    "linter"
  ],
  "galleryBanner": {
    "color": "#0d1117",
    "theme": "dark"
  },
  "badges": [
    {
      "url": "https://img.shields.io/badge/License-Apache_2.0-blue.svg",
      "href": "https://github.com/jahidul456/agentguard/blob/main/LICENSE",
      "description": "Apache-2.0 License"
    },
    {
      "url": "https://img.shields.io/badge/Privacy-100%25%20Offline-success.svg",
      "href": "https://github.com/jahidul456/agentguard/blob/main/SECURITY.md",
      "description": "100% Offline Static Analysis"
    },
    {
      "url": "https://img.shields.io/badge/Telemetry-Zero%20Data%20Collected-informational.svg",
      "href": "https://github.com/jahidul456/agentguard/blob/main/SECURITY.md",
      "description": "Zero Telemetry"
    }
  ],
  "qna": "https://github.com/jahidul456/agentguard/discussions",
  "repository": {
    "type": "git",
    "url": "https://github.com/jahidul456/agentguard.git"
  },
  "bugs": {
    "url": "https://github.com/jahidul456/agentguard/issues"
  },
  "homepage": "https://github.com/jahidul456/agentguard#readme",
  "icon": "resources/icons/agentguard-icon.png",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentguard-explorer",
          "title": "AgentGuard",
          "icon": "resources/icons/agentguard-shield.svg"
        }
      ],
      "panel": [
        {
          "id": "agentguard-panel",
          "title": "AgentGuard",
          "icon": "resources/icons/agentguard-shield.svg"
        }
      ]
    },
    "views": {
      "agentguard-explorer": [
        {
          "type": "webview",
          "id": "agentguard.findingsView",
          "name": "AgentGuard"
        }
      ],
      "agentguard-panel": [
        {
          "type": "webview",
          "id": "agentguard.issuesView",
          "name": "AgentGuard — Codebase Issues"
        }
      ]
    },
    "commands": [
      {
        "command": "agentguard.scanWorkspace",
        "title": "AgentGuard: Scan Workspace",
        "icon": "$(refresh)"
      },
      {
        "command": "agentguard.showOutput",
        "title": "AgentGuard: Show Output Log",
        "icon": "$(output)"
      },
      {
        "command": "agentguard.generateReport",
        "title": "AgentGuard: Generate Safety Report",
        "icon": "$(file-text)"
      },
      {
        "command": "agentguard.clearFindings",
        "title": "AgentGuard: Clear Findings",
        "icon": "$(clear-all)"
      },
      {
        "command": "agentguard.focusSidebar",
        "title": "AgentGuard: Focus Sidebar View",
        "icon": "$(shield)"
      },
      {
        "command": "agentguard.copyFindingFixPrompt",
        "title": "AgentGuard: Copy AI Fix Prompt",
        "icon": "$(sparkle)"
      },
      {
        "command": "agentguard.exportJsonReport",
        "title": "AgentGuard: Export Findings as JSON",
        "icon": "$(json)"
      },
      {
        "command": "agentguard.openProblemsPanel",
        "title": "AgentGuard: Open Problems Panel",
        "icon": "$(list-unordered)"
      },
      {
        "command": "agentguard.toggleMonitoring",
        "title": "AgentGuard: Pause/Resume Monitoring",
        "icon": "$(play-circle)"
      },
      {
        "command": "agentguard.recheckFinding",
        "title": "AgentGuard: Recheck Issue",
        "icon": "$(sync)"
      },
      {
        "command": "agentguard.ignoreFinding",
        "title": "AgentGuard: Ignore Issue",
        "icon": "$(eye-closed)"
      },
      {
        "command": "agentguard.showFindingDiff",
        "title": "AgentGuard: View Change Diff",
        "icon": "$(diff)"
      },
      {
        "command": "agentguard.applyQuickFix",
        "title": "AgentGuard: Apply Available Quick Fix",
        "icon": "$(wrench)"
      },
      {
        "command": "agentguard.tryInteractiveDemo",
        "title": "AgentGuard: Try Interactive Demo",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentguard.scanWorkspace",
          "when": "view == agentguard.findingsView || view == agentguard.issuesView",
          "group": "navigation@1"
        },
        {
          "command": "agentguard.toggleMonitoring",
          "when": "view == agentguard.findingsView || view == agentguard.issuesView",
          "group": "navigation@2"
        },
        {
          "command": "agentguard.generateReport",
          "when": "view == agentguard.findingsView || view == agentguard.issuesView",
          "group": "navigation@3"
        },
        {
          "command": "agentguard.exportJsonReport",
          "when": "view == agentguard.findingsView || view == agentguard.issuesView",
          "group": "navigation@4"
        },
        {
          "command": "agentguard.clearFindings",
          "when": "view == agentguard.findingsView || view == agentguard.issuesView",
          "group": "navigation@5"
        }
      ]
    },
    "configuration": {
      "title": "AgentGuard",
      "properties": {
        "agentguard.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable AgentGuard automated codebase safety monitoring."
        },
        "agentguard.autoReport": {
          "type": "boolean",
          "default": false,
          "description": "Automatically write .vscode/agentguard-report.md whenever findings change. Disabled by default to prevent workspace pollution."
        },
        "agentguard.logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "info",
          "description": "Output logging verbosity."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package-prod",
    "compile": "tsc -p ./ --noEmit",
    "watch": "node esbuild.js --watch",
    "build": "node esbuild.js",
    "package-prod": "node esbuild.js --production",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "npm run pretest && mocha -r ./out/test/unit/setup.js --ui tdd out/test/unit/**/*.test.js",
    "test:integration": "npm run build && npm run pretest && node out/test/integration/runTest.js",
    "package-extension": "vsce package --no-git-tag-version"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^2.26.0",
    "esbuild": "^0.21.4",
    "mocha": "^10.4.0",
    "typescript": "^5.4.5"
  }
}
